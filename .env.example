# Copy to .env.local and fill in. Anything prefixed NEXT_PUBLIC_ is exposed to the browser.

# Meta Ads Manager → Events Manager → your Pixel → Settings
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 → Admin → Data Streams → Measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=

# resend.com → API Keys (used by /api/lead to email a notification when a lead submits)
RESEND_API_KEY=
LEAD_FROM_EMAIL=leads@yourdomain.com
LEAD_NOTIFICATION_EMAIL=karl@yourdomain.com
